---
import Footer from "../components/Footer.astro";
import "../assets/css/style.scss";

const { frontmatter, title = frontmatter?.title } = Astro.props;
const pageTitle = title ? `f.n. epsilon, "${title}"` : "f.n. epsilon";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="shortcut icon" href="/assets/img/favicon.avif" type="image/avif" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <main>
    <slot />
    <Footer />
    </main>
  </body>
</html>
