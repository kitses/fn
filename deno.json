{
  "lint": {
    "exclude": [
      "_site/"
    ],
    "rules": {
      "tags": [
        "recommended"
      ],
      "include": [
        "eqeqeq",
        "no-top-level-await",
        "no-sync-fn-in-async-fn",
        "no-useless-rename"
      ]
    }
  },
  "tasks": {
    "serve": "deno run -A npm:@11ty/eleventy@^3.1.2 --config=eleventy.config.js --serve",
    "build": "deno run -A npm:@11ty/eleventy@^3.1.2 --config=eleventy.config.js"
  },
  "imports": {
    "@std/fs": "jsr:@std/fs@^1.0.22",
    "@std/path": "jsr:@std/path@^1.1.4",
    "cssnano": "npm:cssnano@^7.1.2",
    "cssnano-preset-advanced": "npm:cssnano-preset-advanced@^7.0.10",
    "esbuild": "npm:esbuild@^0.26.0",
    "html-minifier-terser": "npm:html-minifier-terser@^7.2.0",
    "markdown-it": "npm:markdown-it@^14.1.0",
    "markdown-it-attrs": "npm:markdown-it-attrs@^4.3.1",
    "postcss": "npm:postcss@^8.5.6",
    "sass": "npm:sass@^1.97.3"
  }
}